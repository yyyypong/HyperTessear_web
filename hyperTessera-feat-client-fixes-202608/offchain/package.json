{
  "name": "@hypertessera/offchain",
  "version": "0.1.0",
  "description": "HyperTessera Earn Module E — TypeScript SDK, OnChainEventIndexer, KeeperBot, SettlementOperator (development-plan.md §3.1.2/§3.2.2/§3.3.2/§3.4.2/§3.5)",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --no-file-parallelism test/*.integration.test.ts",
    "test:all": "vitest run --no-file-parallelism",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "local:deploy": "tsx scripts/local/deploy.ts",
    "local:test-plan": "tsx scripts/local/runTestPlan.ts"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18"
  }
}
